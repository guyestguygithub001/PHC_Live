# Environment variables for clinic-server
# Copy this file to .env and fill in your actual values
# Never commit the actual .env file - it's in .gitignore

# Neon PostgreSQL connection string
# Get this from your Neon project dashboard under "Connection Details"
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Server port (default 3001 if not set)
PORT=3001

# DHIS2 integration (optional - leave blank to disable auto-sync)
DHIS2_BASE_URL=https://your-dhis2-instance.org
DHIS2_USERNAME=
DHIS2_PASSWORD=
DHIS2_ORG_UNIT_ID=

# JWT secret for inter-service auth (generate with: openssl rand -hex 32)
JWT_SECRET=

# Environment: development | production
APP_ENV=development
